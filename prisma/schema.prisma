// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}
enum AccountStatus {
  ACTIVE
  SUSPENDED
}
enum AddressType {
  HOME
  OFFICE
  OTHER
}
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
enum ProductType {
  READY_TO_WEAR
  MADE_TO_ORDER
  BESPOKE
}
enum MediaType {
  IMAGE
  VIDEO
}
enum CustomizationType {
  TEXT
  SELECT
  COLOR
  BOOLEAN
  NUMBER
}
enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}
enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}
enum PaymentProvider {
  PAYSTACK
  MANUAL
}
enum FulfillmentMethod {
  DELIVERY
  PICKUP
}
enum InquiryType {
  BESPOKE
  ASO_EBI_GROUP
  CORPORATE_BULK
  GENERAL
}
enum InquiryStatus {
  NEW
  CONTACTED
  QUOTED
  ACCEPTED
  DECLINED
  CLOSED
}
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}
enum DiscountType {
  FIXED
  PERCENTAGE
}
enum ContentStatus {
  DRAFT
  PUBLISHED
}
enum NotificationType {
  ORDER_CONFIRMATION
  PAYMENT_RECEIPT
  ORDER_UPDATE
  PASSWORD_RESET
  WELCOME
  INQUIRY_RECEIVED
}
enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String?               
  firstName            String?               
  lastName             String?               
  phone                String?               
  role                 UserRole              @default(CUSTOMER)
  status               AccountStatus         @default(ACTIVE)
  emailVerifiedAt      DateTime?             
  avatarUrl            String?               
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  addresses            Address[]             
  measurementProfiles  MeasurementProfile[]  
  carts                Cart[]                
  wishlistItems        WishlistItem[]        
  orders               Order[]               @relation("CustomerOrders")
  inquiries            Inquiry[]             @relation("CustomerInquiries")
  reviews              Review[]              
  sessions             Session[]             
  authAccounts         AuthAccount[]         
  passwordResetTokens  PasswordResetToken[]  
  notificationLogs     NotificationLog[]     
  auditLogs            AuditLog[]            @relation("AuditActor")
  publishedProducts    Product[]             @relation("ProductPublisher")
  managedOrders        Order[]               @relation("OrderManager")
  createdQuotes        Quote[]               @relation("QuoteCreator")
  @@index([role, status])
}

model AuthAccount {
  id                 String  @id @default(cuid())
  userId             String  
  provider           String  
  providerAccountId  String  
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id         String     @id @default(cuid())
  userId     String     
  tokenHash  String     @unique
  expiresAt  DateTime   
  createdAt  DateTime   @default(now())
  revokedAt  DateTime?  
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id         String     @id @default(cuid())
  userId     String     
  tokenHash  String     @unique
  expiresAt  DateTime   
  usedAt     DateTime?  
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Address {
  id             String       @id @default(cuid())
  userId         String       
  label          String?      
  type           AddressType  @default(HOME)
  recipientName  String       
  phone          String       
  line1          String       
  line2          String?      
  city           String       
  state          String       
  country        String       @default("NG")
  postalCode     String?      
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isDefault])
}

model MeasurementProfile {
  id            String       @id @default(cuid())
  userId        String       
  label         String       
  unit          String       @default("cm")
  measurements  Json         
  notes         String?      
  isDefault     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]   
  orderItems    OrderItem[]  
  @@index([userId])
}

model Collection {
  id                  String               @id @default(cuid())
  name                String               @unique
  slug                String               @unique
  description         String?              
  heroImageUrl        String?              
  mobileHeroImageUrl  String?              
  headline            String?              
  sortOrder           Int                  @default(0)
  isFeatured          Boolean              @default(false)
  status              ContentStatus        @default(DRAFT)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  products            ProductCollection[]  
  @@index([status, sortOrder])
}

model Product {
  id                    String                 @id @default(cuid())
  name                  String                 
  slug                  String                 @unique
  sku                   String?                @unique
  description           String                 @db.Text
  shortDescription      String?                
  type                  ProductType            @default(MADE_TO_ORDER)
  status                ProductStatus          @default(DRAFT)
  basePrice             Decimal?               @db.Decimal(12, 2)
  currency              String                 @default("NGN")
  priceOnRequest        Boolean                @default(false)
  fabric                String?                
  careInstructions      String?                
  leadTimeDays          Int?                   
  featured              Boolean                @default(false)
  publishedById         String?                
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  publishedBy           User?                  @relation("ProductPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  collections           ProductCollection[]    
  media                 ProductMedia[]         
  variants              ProductVariant[]       
  customizationOptions  CustomizationOption[]  
  cartItems             CartItem[]             
  wishlistItems         WishlistItem[]         
  orderItems            OrderItem[]            
  reviews               Review[]               
  @@index([status, featured])
  @@index([createdAt])
}

model ProductCollection {
  productId     String      
  collectionId  String      
  sortOrder     Int         @default(0)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection    Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  @@id([productId, collectionId])
  @@index([collectionId, sortOrder])
}

model ProductMedia {
  id         String     @id @default(cuid())
  productId  String     
  url        String     
  alt        String?    
  type       MediaType  @default(IMAGE)
  sortOrder  Int        @default(0)
  isPrimary  Boolean    @default(false)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, sortOrder])
}

model ProductVariant {
  id               String       @id @default(cuid())
  productId        String       
  sku              String?      @unique
  name             String       
  attributes       Json         
  priceAdjustment  Decimal      @default(0) @db.Decimal(12, 2)
  stockQuantity    Int?         
  isAvailable      Boolean      @default(true)
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems        CartItem[]   
  orderItems       OrderItem[]  
  @@index([productId, isAvailable])
}

model CustomizationOption {
  id               String             @id @default(cuid())
  productId        String             
  name             String             
  key              String             
  type             CustomizationType  
  required         Boolean            @default(false)
  choices          Json?              
  priceAdjustment  Decimal            @default(0) @db.Decimal(12, 2)
  sortOrder        Int                @default(0)
  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, key])
}

model Cart {
  id              String      @id @default(cuid())
  userId          String?     
  guestTokenHash  String?     @unique
  status          CartStatus  @default(ACTIVE)
  expiresAt       DateTime?   
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           CartItem[]  
  orders          Order[]     
  @@index([userId, status])
}

model CartItem {
  id                    String               @id @default(cuid())
  cartId                String               
  productId             String               
  variantId             String?              
  measurementProfileId  String?              
  quantity              Int                  @default(1)
  selectedOptions       Json?                
  customMeasurements    Json?                
  notes                 String?              
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  cart                  Cart                 @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product               Product              @relation(fields: [productId], references: [id])
  variant               ProductVariant?      @relation(fields: [variantId], references: [id])
  measurementProfile    MeasurementProfile?  @relation(fields: [measurementProfileId], references: [id], onDelete: SetNull)
  @@index([cartId])
}

model WishlistItem {
  userId     String    
  productId  String    
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([userId, productId])
}

model Order {
  id                     String              @id @default(cuid())
  orderNumber            String              @unique
  customerId             String?             
  managedById            String?             
  cartId                 String?             
  email                  String              
  phone                  String              
  customerName           String              
  status                 OrderStatus         @default(PENDING_PAYMENT)
  paymentStatus          PaymentStatus       @default(PENDING)
  currency               String              @default("NGN")
  subtotal               Decimal             @db.Decimal(12, 2)
  customizationTotal     Decimal             @default(0) @db.Decimal(12, 2)
  discountTotal          Decimal             @default(0) @db.Decimal(12, 2)
  shippingTotal          Decimal             @default(0) @db.Decimal(12, 2)
  grandTotal             Decimal             @db.Decimal(12, 2)
  fulfillmentMethod      FulfillmentMethod   @default(DELIVERY)
  shippingAddress        Json?               
  deliveryNotes          String?             
  requestedDeliveryDate  DateTime?           
  confirmedDeliveryDate  DateTime?           
  customerNotes          String?             
  adminNotes             String?             
  paidAt                 DateTime?           
  cancelledAt            DateTime?           
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  customer               User?               @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)
  managedBy              User?               @relation("OrderManager", fields: [managedById], references: [id], onDelete: SetNull)
  cart                   Cart?               @relation(fields: [cartId], references: [id], onDelete: SetNull)
  items                  OrderItem[]         
  payments               Payment[]           
  statusEvents           OrderStatusEvent[]  
  quote                  Quote?              @relation("QuoteOrder")
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
}

model OrderItem {
  id                     String               @id @default(cuid())
  orderId                String               
  productId              String?              
  variantId              String?              
  measurementProfileId   String?              
  productName            String               
  productSku             String?              
  productImageUrl        String?              
  variantSnapshot        Json?                
  customizationSnapshot  Json?                
  measurementSnapshot    Json?                
  descriptionSnapshot    String?              
  quantity               Int                  
  unitPrice              Decimal              @db.Decimal(12, 2)
  customizationFee       Decimal              @default(0) @db.Decimal(12, 2)
  lineTotal              Decimal              @db.Decimal(12, 2)
  order                  Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant                ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  measurementProfile     MeasurementProfile?  @relation(fields: [measurementProfileId], references: [id], onDelete: SetNull)
  @@index([orderId])
}

model Payment {
  id                     String           @id @default(cuid())
  orderId                String           
  provider               PaymentProvider  @default(PAYSTACK)
  providerReference      String           @unique
  providerTransactionId  String?          @unique
  status                 PaymentStatus    @default(PENDING)
  amount                 Decimal          @db.Decimal(12, 2)
  currency               String           @default("NGN")
  providerPayload        Json?            
  verifiedAt             DateTime?        
  paidAt                 DateTime?        
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  order                  Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds                Refund[]         
  @@index([orderId, status])
}

model Refund {
  id                 String         @id @default(cuid())
  paymentId          String         
  amount             Decimal        @db.Decimal(12, 2)
  reason             String?        
  providerReference  String?        @unique
  status             PaymentStatus  @default(PENDING)
  createdAt          DateTime       @default(now())
  processedAt        DateTime?      
  payment            Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

model OrderStatusEvent {
  id          String        @id @default(cuid())
  orderId     String        
  fromStatus  OrderStatus?  
  toStatus    OrderStatus   
  note        String?       
  actorId     String?       
  createdAt   DateTime      @default(now())
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, createdAt])
}

model Inquiry {
  id               String         @id @default(cuid())
  reference        String         @unique
  customerId       String?        
  type             InquiryType    
  status           InquiryStatus  @default(NEW)
  name             String         
  email            String         
  phone            String?        
  occasion         String?        
  garmentCount     Int?           
  requestedDate    DateTime?      
  budgetMin        Decimal?       @db.Decimal(12, 2)
  budgetMax        Decimal?       @db.Decimal(12, 2)
  message          String         @db.Text
  inspirationUrls  Json?          
  adminNotes       String?        
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  customer         User?          @relation("CustomerInquiries", fields: [customerId], references: [id], onDelete: SetNull)
  quotes           Quote[]        
  @@index([type, status, createdAt])
}

model Quote {
  id             String       @id @default(cuid())
  quoteNumber    String       @unique
  inquiryId      String       
  createdById    String?      
  status         QuoteStatus  @default(DRAFT)
  currency       String       @default("NGN")
  items          Json         
  subtotal       Decimal      @db.Decimal(12, 2)
  shippingTotal  Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  notes          String?      
  expiresAt      DateTime?    
  sentAt         DateTime?    
  acceptedAt     DateTime?    
  orderId        String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  inquiry        Inquiry      @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  createdBy      User?        @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  order          Order?       @relation("QuoteOrder", fields: [orderId], references: [id], onDelete: SetNull)
  @@index([inquiryId, status])
}

model Review {
  id         String    @id @default(cuid())
  userId     String    
  productId  String    
  rating     Int?      
  title      String?   
  body       String    @db.Text
  approved   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, approved])
}

model ContentPage {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String         
  content         Json           
  status          ContentStatus  @default(DRAFT)
  seoTitle        String?        
  seoDescription  String?        
  publishedAt     DateTime?      
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Faq {
  id         String    @id @default(cuid())
  question   String    
  answer     String    @db.Text
  category   String?   
  sortOrder  Int       @default(0)
  published  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  @@index([published, sortOrder])
}

model SiteAsset {
  id         String    @id @default(cuid())
  key        String    @unique
  url        String    
  alt        String?   
  metadata   Json?     
  updatedAt  DateTime  @updatedAt
}

model SiteSetting {
  key        String    @id
  value      Json      
  updatedAt  DateTime  @updatedAt
}

model NewsletterSubscriber {
  id              String     @id @default(cuid())
  email           String     @unique
  subscribedAt    DateTime   @default(now())
  unsubscribedAt  DateTime?  
  source          String?    
}

model Coupon {
  id         String        @id @default(cuid())
  code       String        @unique
  type       DiscountType  
  value      Decimal       @db.Decimal(12, 2)
  minSpend   Decimal?      @db.Decimal(12, 2)
  maxUses    Int?          
  usedCount  Int           @default(0)
  startsAt   DateTime?     
  expiresAt  DateTime?     
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())
}

model NotificationLog {
  id                 String              @id @default(cuid())
  userId             String?             
  email              String              
  type               NotificationType    
  status             NotificationStatus  @default(QUEUED)
  providerMessageId  String?             
  errorMessage       String?             
  payload            Json?               
  createdAt          DateTime            @default(now())
  sentAt             DateTime?           
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
}

model AuditLog {
  id          String    @id @default(cuid())
  actorId     String?   
  action      String    
  entityType  String    
  entityId    String    
  changes     Json?     
  createdAt   DateTime  @default(now())
  actor       User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId, createdAt])
}
